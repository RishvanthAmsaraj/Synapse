# Voice provider — 'gemini' (default, free-tier). Future: 'openai' (Realtime).
VOICE_PROVIDER=gemini

# Persona — 'companion' (default) | 'teacher' | 'assistant'. Drives voice + personality.
SYNAPSE_PERSONA=companion

# Model used for the live voice session.
VOICE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Gemini prebuilt voice name (e.g. Aoede, Puck, Charon, Kore, Fenrir, Leda).
# Overrides the persona's default voice when set.
VOICE_NAME=Aoede

# API keys
GEMINI_API_KEY=your-gemini-api-key-here

# Server port (optional)
PORT=3001
